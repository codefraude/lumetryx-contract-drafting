# ---- Required ----------------------------------------------------------------
# Server-only Gemini key (https://aistudio.google.com/apikey). Never prefix with NEXT_PUBLIC_.
# Without it the app still runs in "markers only" mode: explicit placeholders are
# detected and can be filled in the Details panel, but the assistant cannot chat.
GEMINI_API_KEY=
# Neon *pooled* connection string (…-pooler…/neondb?sslmode=require) for the app.
DATABASE_URL=
# Neon *direct* (non-pooled) connection string, used only by `npm run db:migrate`.
DATABASE_URL_UNPOOLED=

# ---- Strongly recommended (required for any public deployment) ---------------
# Upstash Redis REST credentials: template-analysis cache, request dedupe locks, rate limits.
# In production the app refuses costly requests if these are missing (fails closed).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Optional ------------------------------------------------------------------
APP_URL=http://localhost:3000
GEMINI_MODEL=gemini-3.1-flash-lite
# Lowest documented Gemini 3 thinking level; raise only if quality tests require it.
GEMINI_THINKING_LEVEL=minimal
# Per-session AI ceilings (bound usage; they are not a billing guarantee — set a budget in Google Cloud too).
AI_MAX_REQUESTS_PER_SESSION=80
AI_MAX_TOKENS_PER_SESSION=400000
# Saved drafts are kept this many days after their last save (default 30). The browser's
# anonymous credential has the same lifetime and slides with activity. Expired drafts are never
# served; `npm run db:cleanup` removes them (and expired sessions without drafts).
DRAFT_RETENTION_DAYS=30
# LOCAL TESTING ONLY: lets `npm start` run without Redis (no rate limits, no dedupe). Never on a public host.
ALLOW_NO_REDIS=false

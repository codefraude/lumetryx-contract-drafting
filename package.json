{
  "name": "lumetryx-contract-drafting",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs}\"",
    "check:cycles": "eslint -c eslint.cycles.config.mjs src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:word": "tsx scripts/word/check.ts",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:cleanup": "tsx --conditions=react-server scripts/cleanup.ts",
    "smoke:gemini": "tsx scripts/gemini-smoke.ts",
    "smoke:gateway": "tsx scripts/gemini-smoke.ts --gateway",
    "eval:conversation": "tsx scripts/eval-conversation.ts"
  },
  "dependencies": {
    "@ai-sdk/gateway": "4.0.91",
    "@ai-sdk/google": "4.0.79",
    "@neondatabase/serverless": "1.1.0",
    "@tanstack/react-query": "5.103.2",
    "@upstash/ratelimit": "2.1.0",
    "@upstash/redis": "1.39.0",
    "@xmldom/xmldom": "0.9.12",
    "ai": "7.0.113",
    "drizzle-orm": "0.45.3",
    "jszip": "3.10.2",
    "lucide-react": "1.47.0",
    "next": "16.3.6",
    "next-intl": "4.14.7",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "superdoc": "2.17.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sparticuz/chromium": "153.0.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@superdoc/sdk": "2.14.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "docx": "9.7.1",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "playwright-core": "1.63.0",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
